{
  "easycom": {
    "autoscan": true,
    "custom": {
      "^yt-(.*)": "@rao2126340634/yt-ui/src/components/yt-$1/yt-$1.vue"
    }
  },
  "pages": [
    {
      "path": "pages/index",
      "style": {
        "navigationBarTitleText": "选择测试组件"
      }
    },
    {
      "path": "pages/schedule",
      "style": {
        "navigationBarTitleText": "课程表组件"
      }
    },
    {
      "path": "pages/virtual-list",
      "style": {
        "navigationBarTitleText": "虚拟列表组件"
      }
    }
  ],
  "globalStyle": {
    "navigationBarTextStyle": "black",
    "navigationBarTitleText": "yt-ui",
    "navigationBarBackgroundColor": "#F8F8F8",
    "backgroundColor": "#F8F8F8"
  }
}
